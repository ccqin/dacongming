@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="main-layout">
    <Header />

    <main class="main-content">
        @Body
    </main>

    <Footer />
</div>

<div id="blazor-error-ui">
    <i class="fas fa-exclamation-triangle"></i>
    应用加载出错，请
    <a href="" class="reload">重新加载</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private MudTheme Theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#e50914",
            Secondary = "#38bdf8",
            Background = "#0a0a0a",
            Surface = "#141414",
            AppbarBackground = "#0a0a0a",
            TextPrimary = "#f8fafc",
            ActionDefault = "#94a3b8",
        }
    };
}

<style>
    .main-layout {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .main-content {
        flex: 1;
    }

    #blazor-error-ui {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: #c00;
        color: white;
        padding: 1rem;
        text-align: center;
        z-index: 9999;
        font-size: 1rem;
    }

    #blazor-error-ui .reload {
        color: white;
        font-weight: bold;
        text-decoration: underline;
    }

    #blazor-error-ui .dismiss {
        position: absolute;
        right: 1rem;
        cursor: pointer;
        text-decoration: none;
    }
</style>
