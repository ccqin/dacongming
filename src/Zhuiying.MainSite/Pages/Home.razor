@page "/"
@inject MovieService MovieService
@inject NavigationManager Navigation

<PageTitle>追影 - 首页</PageTitle>

<div class="home-page">
    @if (isLoading)
    {
        @* 骨架屏 - Hero Banner *@
        <div class="skeleton-hero"></div>
        
        @* 骨架屏 - 分类区域 *@
        <section class="category-section">
            <div class="skeleton-title"></div>
            <div class="card-row">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton-poster"></div>
                    </div>
                }
            </div>
        </section>
        
        <section class="category-section">
            <div class="skeleton-title"></div>
            <div class="card-row">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="skeleton-card">
                        <div class="skeleton-poster"></div>
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        @* Hero Banner *@
        @if (trendingMovies.Count > 0)
        {
            var hero = trendingMovies.First();
            <section class="hero-banner" style="background-image: url('@MovieService.GetBackdropUrl(hero.BackdropPath)')">
                <div class="hero-overlay"></div>
                <div class="hero-content">
                    <h1>@hero.Title</h1>
                    <p class="hero-overview">@hero.Overview</p>
                    <MudButton 
                        Variant="Variant.Filled" 
                        Color="Color.Primary" 
                        Size="Size.Large"
                        OnClick="() => GoToDetail(hero.TmdbId, hero.MediaType)">
                        查看详情
                    </MudButton>
                </div>
            </section>
        }

        @* 热门电影 *@
        <section class="category-section">
            <h2>🔥 热门电影</h2>
            <div class="card-row">
                @foreach (var movie in trendingMovies)
                {
                    <MovieCard Movie="movie" OnClick="() => GoToDetail(movie.TmdbId, movie.MediaType)" />
                }
            </div>
        </section>

        @* 最新上映 *@
        <section class="category-section">
            <h2>🎬 最新上映</h2>
            <div class="card-row">
                @foreach (var movie in latestMovies)
                {
                    <MovieCard Movie="movie" OnClick="() => GoToDetail(movie.TmdbId, movie.MediaType)" />
                }
            </div>
        </section>

        @* 热门剧集 *@
        @if (trendingTvs.Count > 0)
        {
            <section class="category-section">
                <h2>📺 热门剧集</h2>
                <div class="card-row">
                    @foreach (var tv in trendingTvs)
                    {
                        <MovieCard Movie="tv" OnClick="() => GoToDetail(tv.TmdbId, tv.MediaType)" />
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    private List<Movie> trendingMovies = new();
    private List<Movie> latestMovies = new();
    private List<Movie> trendingTvs = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var trendingTask = MovieService.GetTrendingMoviesAsync();
            var latestTask = MovieService.GetLatestMoviesAsync();
            var tvsTask = MovieService.GetTrendingMoviesAsync(type: "tv");

            await Task.WhenAll(trendingTask, latestTask, tvsTask);

            trendingMovies = await trendingTask;
            latestMovies = await latestTask;
            trendingTvs = await tvsTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载失败: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToDetail(int id, string mediaType)
    {
        Navigation.NavigateTo($"/movie/{mediaType}/{id}");
    }
}

<style>
    .home-page {
        padding-top: 60px;
    }

    /* Skeleton Loading */
    .skeleton-hero {
        width: 100%;
        height: 70vh;
        min-height: 450px;
        background: linear-gradient(90deg, #1a1a2e 25%, #252540 50%, #1a1a2e 75%);
        background-size: 200% 100%;
        animation: shimmer 1.8s infinite;
    }

    .skeleton-title {
        width: 180px;
        height: 24px;
        border-radius: 4px;
        margin-bottom: 1rem;
        background: linear-gradient(90deg, #1a1a2e 25%, #252540 50%, #1a1a2e 75%);
        background-size: 200% 100%;
        animation: shimmer 1.8s infinite;
    }

    .skeleton-card {
        flex: 0 0 180px;
    }

    .skeleton-poster {
        width: 100%;
        aspect-ratio: 2/3;
        border-radius: 8px;
        background: linear-gradient(90deg, #1a1a2e 25%, #252540 50%, #1a1a2e 75%);
        background-size: 200% 100%;
        animation: shimmer 1.8s infinite;
    }

    @@keyframes shimmer {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }

    .hero-banner {
        position: relative;
        height: 70vh;
        min-height: 450px;
        max-height: 700px;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: flex-end;
        animation: heroFadeIn 1.2s ease-out;
    }

    @@keyframes heroFadeIn {
        from { opacity: 0; transform: scale(1.05); }
        to { opacity: 1; transform: scale(1); }
    }

    .category-section {
        animation: slideUp 0.6s ease-out both;
    }

    .category-section:nth-child(2) { animation-delay: 0.1s; }
    .category-section:nth-child(3) { animation-delay: 0.2s; }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
