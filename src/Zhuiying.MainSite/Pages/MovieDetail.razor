@page "/movie/{MediaType}/{TmdbId:int}"
@inject MovieService MovieService
@inject FavoritesService FavoritesService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>@(movie?.Title ?? "加载中...") - 追影</PageTitle>

<div class="detail-page">
    @if (movie == null || isLoading)
    {
        <div class="loading-container">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        @* 背景图 *@
        <section class="detail-backdrop">
            <LazyImage Src="@MovieService.GetBackdropUrl(movie.BackdropPath, "original")" Alt="@movie.Title" CssClass="detail-backdrop-img" />
            <div class="backdrop-overlay"></div>
        </section>

        @* 详情内容 *@
        <section class="detail-info">
            <div class="detail-poster">
                <LazyImage Src="@MovieService.GetPosterUrl(movie.PosterPath, "w500")" Alt="@movie.Title" CssClass="detail-poster-img" />
            </div>

            <div class="detail-text">
                <h1>@movie.Title</h1>
                
                @if (movie.OriginalTitle != movie.Title && !string.IsNullOrEmpty(movie.OriginalTitle))
                {
                    <p class="original-title">@movie.OriginalTitle</p>
                }

                <div class="detail-meta">
                    <span class="rating">⭐ @movie.TmdbVoteAverage.ToString("F1")</span>
                    <span>@movie.ReleaseDate?.Substring(0, 4)</span>
                    @if (movie.Runtime.HasValue)
                    {
                        <span>@movie.Runtime 分钟</span>
                    }
                    <span class="media-type">@(movie.MediaType == "movie" ? "电影" : "电视剧")</span>
                </div>

                @if (!string.IsNullOrEmpty(movie.Overview))
                {
                    <div class="detail-overview">
                        <h3>简介</h3>
                        <p>@movie.Overview</p>
                    </div>
                }

                @if (movie.Douban != null)
                {
                    <div class="douban-info">
                        <h3>豆瓣评分</h3>
                        <div class="douban-rating">
                            <span class="rating-value">@movie.Douban.Rating.ToString("F1")</span>
                            <span class="rating-count">(@movie.Douban.RatingCount 人评价)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(movie.Douban.Summary))
                        {
                            <p class="douban-summary">@movie.Douban.Summary</p>
                        }
                    </div>
                }

                <div class="actions">
                    @if (isFavorite)
                    {
                        <MudButton
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            Size="Size.Large"
                            StartIcon="@Icons.Material.Filled.Favorite"
                            OnClick="ToggleFavorite">
                            已收藏
                        </MudButton>
                    }
                    else
                    {
                        <MudButton
                            Variant="Variant.Outlined"
                            Color="Color.Primary"
                            Size="Size.Large"
                            StartIcon="@Icons.Material.Filled.FavoriteBorder"
                            OnClick="ToggleFavorite">
                            收藏
                        </MudButton>
                    }
                    <MudButton
                        Variant="Variant.Filled"
                        Color="Color.Primary"
                        Size="Size.Large"
                        Href="@(movie.MediaType == "movie" ? $"https://www.themoviedb.org/movie/{movie.TmdbId}" : $"https://www.themoviedb.org/tv/{movie.TmdbId}")"
                        Target="_blank">
                        在 TMDB 查看
                    </MudButton>
                </div>
            </div>
        </section>

        @* 演员列表 *@
        @if (movie.Credits != null && movie.Credits.Any())
        {
            <section class="detail-section">
                <h2>🎭 演员阵容</h2>
                <div class="cast-scroll">
                    @foreach (var cast in movie.Credits)
                    {
                        <div class="cast-card">
                            <div class="cast-avatar">
                                @if (!string.IsNullOrEmpty(cast.ProfilePath))
                                {
                                    <LazyImage Src="@MovieService.GetPosterUrl(cast.ProfilePath, "w185")" Alt="@cast.Name" CssClass="cast-avatar-img" />
                                }
                                else
                                {
                                    <div class="cast-placeholder">👤</div>
                                }
                            </div>
                            <div class="cast-name">@cast.Name</div>
                            @if (!string.IsNullOrEmpty(cast.Character))
                            {
                                <div class="cast-character">@cast.Character</div>
                            }
                        </div>
                    }
                </div>
            </section>
        }

        @* 相似推荐 *@
        @if (movie.Similar != null && movie.Similar.Any())
        {
            <section class="detail-section">
                <h2>🎬 相似推荐</h2>
                <div class="similar-grid">
                    @foreach (var item in movie.Similar)
                    {
                        <div class="similar-card" @onclick="@(() => NavigateToDetail(item.TmdbId, item.MediaType))">
                            <LazyImage Src="@MovieService.GetPosterUrl(item.PosterPath, "w342")" Alt="@item.Title" CssClass="similar-card-img" />
                            <div class="similar-info">
                                <div class="similar-title">@item.Title</div>
                                @if (item.TmdbVoteAverage > 0)
                                {
                                    <div class="similar-rating">⭐ @item.TmdbVoteAverage.ToString("F1")</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>
        }

        @* 预告片 *@
        @if (movie.Videos != null && movie.Videos.Any())
        {
            <section class="detail-section">
                <h2>🎥 预告片</h2>
                <div class="video-list">
                    @foreach (var video in movie.Videos)
                    {
                        <div class="video-item">
                            <div class="video-player">
                                <iframe 
                                    src="https://www.youtube.com/embed/@video.Key" 
                                    frameborder="0" 
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                    allowfullscreen>
                                </iframe>
                            </div>
                            <div class="video-title">@video.Name</div>
                        </div>
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    [Parameter] public string MediaType { get; set; } = "movie";
    [Parameter] public int TmdbId { get; set; }

    private Movie? movie;
    private bool isLoading = true;
    private bool isFavorite = false;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            movie = await MovieService.GetMovieDetailsAsync(TmdbId, MediaType);
            // 检查是否已收藏
            isFavorite = await FavoritesService.IsFavoriteAsync(TmdbId, MediaType);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载详情失败: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleFavorite()
    {
        if (isFavorite)
        {
            await FavoritesService.RemoveFavoriteAsync(TmdbId, MediaType);
            isFavorite = false;
        }
        else
        {
            await FavoritesService.AddFavoriteAsync(TmdbId, MediaType, movie?.Title, movie?.PosterPath);
            isFavorite = true;
        }
        StateHasChanged();
    }

    private void NavigateToDetail(int tmdbId, string mediaType)
    {
        Navigation.NavigateTo($"/movie/{mediaType}/{tmdbId}");
    }
}

<style>
    .detail-page {
        padding-top: 60px;
    }

    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
    }

    .detail-backdrop {
        position: relative;
        width: 100%;
        height: 50vh;
        min-height: 350px;
        overflow: hidden;
    }

    .detail-backdrop img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.4);
    }

    .backdrop-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--zhui-bg) 0%, transparent 100%);
    }

    .detail-info {
        position: relative;
        padding: 0 5%;
        margin-top: -150px;
        z-index: 2;
        display: flex;
        gap: 2rem;
    }

    .detail-poster {
        flex: 0 0 250px;
    }

    .detail-poster img {
        width: 100%;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    }

    .detail-text {
        flex: 1;
        padding-top: 2rem;
    }

    .detail-text h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .original-title {
        color: var(--zhui-muted);
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    .detail-meta {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1rem;
        color: var(--zhui-muted);
        font-size: 0.9rem;
    }

    .detail-meta .rating {
        color: #fbbf24;
        font-weight: 600;
    }

    .media-type {
        background: var(--zhui-primary);
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .detail-overview,
    .douban-info {
        margin: 1.5rem 0;
    }

    .detail-overview h3,
    .douban-info h3 {
        font-size: 1.2rem;
        margin-bottom: 0.75rem;
        color: var(--zhui-text);
    }

    .detail-overview p {
        color: #cbd5e1;
        font-size: 1rem;
        line-height: 1.8;
    }

    .douban-rating {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .rating-value {
        font-size: 2rem;
        font-weight: 800;
        color: #fbbf24;
    }

    .rating-count {
        color: var(--zhui-muted);
        font-size: 0.9rem;
    }

    .douban-summary {
        color: #cbd5e1;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .actions {
        margin-top: 2rem;
    }

    /* 新增板块通用样式 */
    .detail-section {
        margin: 3rem 5%;
    }

    .detail-section h2 {
        font-size: 1.5rem;
        margin-bottom: 1.5rem;
        color: var(--zhui-text);
    }

    /* 演员列表 */
    .cast-scroll {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        padding-bottom: 1rem;
        scrollbar-width: thin;
        scrollbar-color: var(--zhui-surface) transparent;
    }

    .cast-scroll::-webkit-scrollbar {
        height: 6px;
    }

    .cast-scroll::-webkit-scrollbar-thumb {
        background: var(--zhui-surface);
        border-radius: 3px;
    }

    .cast-card {
        flex: 0 0 120px;
        text-align: center;
    }

    .cast-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        overflow: hidden;
        margin-bottom: 0.75rem;
        background: var(--zhui-surface);
    }

    .cast-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cast-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: var(--zhui-muted);
    }

    .cast-name {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--zhui-text);
        margin-bottom: 0.25rem;
    }

    .cast-character {
        font-size: 0.8rem;
        color: var(--zhui-muted);
    }

    /* 相似推荐 */
    .similar-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 1.5rem;
    }

    .similar-card {
        cursor: pointer;
        transition: transform 0.3s ease;
        border-radius: 8px;
        overflow: hidden;
    }

    .similar-card:hover {
        transform: translateY(-8px);
    }

    .similar-card img {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        display: block;
    }

    .similar-info {
        padding: 0.75rem;
        background: var(--zhui-surface);
    }

    .similar-title {
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--zhui-text);
        margin-bottom: 0.25rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .similar-rating {
        font-size: 0.85rem;
        color: #fbbf24;
    }

    /* 预告片 */
    .video-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .video-item {
        width: 100%;
        max-width: 800px;
    }

    .video-player {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%;
        background: var(--zhui-surface);
        border-radius: 8px;
        overflow: hidden;
    }

    .video-player iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
    }

    .video-title {
        margin-top: 0.5rem;
        font-size: 1rem;
        color: var(--zhui-text);
    }

    @@media (max-width: 768px) {
        .detail-info {
            flex-direction: column;
            margin-top: -80px;
        }

        .detail-poster {
            flex: 0 0 auto;
            max-width: 200px;
            margin: 0 auto;
        }

        .detail-text h1 {
            font-size: 1.8rem;
        }
    }
</style>
