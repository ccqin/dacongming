@page "/movie/{MediaType}/{TmdbId:int}"
@inject MovieService MovieService
@inject NavigationManager Navigation

<PageTitle>@(movie?.Title ?? "加载中...") - 追影</PageTitle>

<div class="detail-page">
    @if (movie == null || isLoading)
    {
        <div class="loading-container">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        @* 背景图 *@
        <section class="detail-backdrop">
            <img src="@MovieService.GetBackdropUrl(movie.BackdropPath, "original")" alt="@movie.Title" />
            <div class="backdrop-overlay"></div>
        </section>

        @* 详情内容 *@
        <section class="detail-info">
            <div class="detail-poster">
                <img src="@MovieService.GetPosterUrl(movie.PosterPath, "w500")" alt="@movie.Title" />
            </div>

            <div class="detail-text">
                <h1>@movie.Title</h1>
                
                @if (movie.OriginalTitle != movie.Title && !string.IsNullOrEmpty(movie.OriginalTitle))
                {
                    <p class="original-title">@movie.OriginalTitle</p>
                }

                <div class="detail-meta">
                    <span class="rating">⭐ @movie.TmdbVoteAverage.ToString("F1")</span>
                    <span>@movie.ReleaseDate?.Substring(0, 4)</span>
                    @if (movie.Runtime.HasValue)
                    {
                        <span>@movie.Runtime 分钟</span>
                    }
                    <span class="media-type">@(movie.MediaType == "movie" ? "电影" : "电视剧")</span>
                </div>

                @if (!string.IsNullOrEmpty(movie.Overview))
                {
                    <div class="detail-overview">
                        <h3>简介</h3>
                        <p>@movie.Overview</p>
                    </div>
                }

                @if (movie.Douban != null)
                {
                    <div class="douban-info">
                        <h3>豆瓣评分</h3>
                        <div class="douban-rating">
                            <span class="rating-value">@movie.Douban.Rating.ToString("F1")</span>
                            <span class="rating-count">(@movie.Douban.RatingCount 人评价)</span>
                        </div>
                        @if (!string.IsNullOrEmpty(movie.Douban.Summary))
                        {
                            <p class="douban-summary">@movie.Douban.Summary</p>
                        }
                    </div>
                }

                <div class="actions">
                    <MudButton 
                        Variant="Variant.Filled" 
                        Color="Color.Primary" 
                        Size="Size.Large"
                        Href="@(movie.MediaType == "movie" ? $"https://www.themoviedb.org/movie/{movie.TmdbId}" : $"https://www.themoviedb.org/tv/{movie.TmdbId}")"
                        Target="_blank">
                        在 TMDB 查看
                    </MudButton>
                </div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public string MediaType { get; set; } = "movie";
    [Parameter] public int TmdbId { get; set; }
    
    private Movie? movie;
    private bool isLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        try
        {
            movie = await MovieService.GetMovieDetailsAsync(TmdbId, MediaType);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载详情失败: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}

<style>
    .detail-page {
        padding-top: 60px;
    }

    .loading-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
    }

    .detail-backdrop {
        position: relative;
        width: 100%;
        height: 50vh;
        min-height: 350px;
        overflow: hidden;
    }

    .detail-backdrop img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: brightness(0.4);
    }

    .backdrop-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, var(--zhui-bg) 0%, transparent 100%);
    }

    .detail-info {
        position: relative;
        padding: 0 5%;
        margin-top: -150px;
        z-index: 2;
        display: flex;
        gap: 2rem;
    }

    .detail-poster {
        flex: 0 0 250px;
    }

    .detail-poster img {
        width: 100%;
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.6);
    }

    .detail-text {
        flex: 1;
        padding-top: 2rem;
    }

    .detail-text h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
    }

    .original-title {
        color: var(--zhui-muted);
        font-size: 1.2rem;
        margin-bottom: 1rem;
    }

    .detail-meta {
        display: flex;
        gap: 1rem;
        align-items: center;
        margin-bottom: 1rem;
        color: var(--zhui-muted);
        font-size: 0.9rem;
    }

    .detail-meta .rating {
        color: #fbbf24;
        font-weight: 600;
    }

    .media-type {
        background: var(--zhui-primary);
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .detail-overview,
    .douban-info {
        margin: 1.5rem 0;
    }

    .detail-overview h3,
    .douban-info h3 {
        font-size: 1.2rem;
        margin-bottom: 0.75rem;
        color: var(--zhui-text);
    }

    .detail-overview p {
        color: #cbd5e1;
        font-size: 1rem;
        line-height: 1.8;
    }

    .douban-rating {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .rating-value {
        font-size: 2rem;
        font-weight: 800;
        color: #fbbf24;
    }

    .rating-count {
        color: var(--zhui-muted);
        font-size: 0.9rem;
    }

    .douban-summary {
        color: #cbd5e1;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .actions {
        margin-top: 2rem;
    }

    @@media (max-width: 768px) {
        .detail-info {
            flex-direction: column;
            margin-top: -80px;
        }

        .detail-poster {
            flex: 0 0 auto;
            max-width: 200px;
            margin: 0 auto;
        }

        .detail-text h1 {
            font-size: 1.8rem;
        }
    }
</style>
