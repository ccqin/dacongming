@page "/browse"
@inject MovieService MovieService
@inject NavigationManager Navigation

<PageTitle>影视筛选 - 追影</PageTitle>

<div class="browse-page">
    <div class="browse-header">
        <h1>🎬 影视筛选</h1>
        <div class="filter-bar">
            <div class="filter-group">
                <label>类型</label>
                <select @bind="selectedType" @bind:after="ApplyFilters">
                    <option value="movie">电影</option>
                    <option value="tv">电视剧</option>
                </select>
            </div>

            <div class="filter-group">
                <label>流派</label>
                <select @bind="selectedGenreId" @bind:after="ApplyFilters">
                    <option value="0">全部流派</option>
                    @foreach (var genre in genres)
                    {
                        <option value="@genre.Id">@genre.Name</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>年份</label>
                <select @bind="selectedYear" @bind:after="ApplyFilters">
                    <option value="0">全部年份</option>
                    @foreach (var year in years)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>

            <div class="filter-group">
                <label>最低评分</label>
                <select @bind="minRating" @bind:after="ApplyFilters">
                    <option value="0">不限</option>
                    <option value="5">5.0+</option>
                    <option value="6">6.0+</option>
                    <option value="7">7.0+</option>
                    <option value="8">8.0+</option>
                    <option value="9">9.0+</option>
                </select>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="skeleton-grid">
            @for (int i = 0; i < 12; i++)
            {
                <div class="skeleton-card">
                    <div class="skeleton-poster shimmer"></div>
                </div>
            }
        </div>
    }
    else if (movies.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🎭</div>
            <h2>暂无结果</h2>
            <p>没有找到符合条件的影视作品，试试调整筛选条件</p>
            <button class="reset-btn" @onclick="ResetFilters">重置筛选</button>
        </div>
    }
    else
    {
        <div class="results-info">
            <span>第 @currentPage / @totalPages 页，共找到 @movies.Count 部作品</span>
        </div>

        <div class="results-grid">
            @foreach (var movie in movies)
            {
                <MovieCard Movie="movie" OnClick="() => GoToDetail(movie.TmdbId, movie.MediaType)" />
            }
        </div>

        @if (totalPages > 1)
        {
            <div class="pagination">
                <button class="page-btn" disabled="@(currentPage <= 1)" @onclick="PrevPage">上一页</button>
                <span class="page-info">@currentPage / @totalPages</span>
                <button class="page-btn" disabled="@(currentPage >= totalPages)" @onclick="NextPage">下一页</button>
            </div>
        }
    }
</div>

@code {
    private string selectedType = "movie";
    private int selectedGenreId = 0;
    private int selectedYear = 0;
    private double minRating = 0;

    private List<Movie> movies = new();
    private List<Genre> genres = new();
    private List<int> years = new();
    private bool isLoading = true;
    private int currentPage = 1;
    private int totalPages = 1;

    protected override async Task OnInitializedAsync()
    {
        // 生成年份列表（最近 15 年）
        var currentYear = DateTime.Now.Year;
        years = Enumerable.Range(currentYear - 14, 15).OrderByDescending(y => y).ToList();

        await LoadGenres();
        await LoadAndFilterMovies();
    }

    private async Task LoadGenres()
    {
        try
        {
            genres = await MovieService.GetGenresAsync(selectedType);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载流派失败: {ex.Message}");
            // 使用硬编码的默认流派作为备选
            genres = GetDefaultGenres();
        }
    }

    private async Task LoadAndFilterMovies()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            int? genreId = selectedGenreId > 0 ? selectedGenreId : null;
            int? year = selectedYear > 0 ? selectedYear : null;
            double? rating = minRating > 0 ? minRating : null;

            var (result, pages) = await MovieService.DiscoverMoviesAsync(
                type: selectedType, genreId: genreId, year: year,
                minRating: rating, page: currentPage);

            movies = result;
            totalPages = pages > 0 ? pages : 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载数据失败: {ex.Message}");
            movies.Clear();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        // 如果类型变了，重新加载流派
        await LoadGenres();
        await LoadAndFilterMovies();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadAndFilterMovies();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadAndFilterMovies();
        }
    }

    private async Task ResetFilters()
    {
        selectedType = "movie";
        selectedGenreId = 0;
        selectedYear = 0;
        minRating = 0;
        currentPage = 1;
        await LoadGenres();
        await LoadAndFilterMovies();
    }

    private void GoToDetail(int tmdbId, string mediaType)
    {
        Navigation.NavigateTo($"/movie/{mediaType}/{tmdbId}");
    }

    private static List<Genre> GetDefaultGenres() => new()
    {
        new Genre { Id = 28, Name = "动作" }, new Genre { Id = 12, Name = "冒险" },
        new Genre { Id = 16, Name = "动画" }, new Genre { Id = 35, Name = "喜剧" },
        new Genre { Id = 80, Name = "犯罪" }, new Genre { Id = 99, Name = "纪录" },
        new Genre { Id = 18, Name = "剧情" }, new Genre { Id = 10751, Name = "家庭" },
        new Genre { Id = 14, Name = "奇幻" }, new Genre { Id = 36, Name = "历史" },
        new Genre { Id = 27, Name = "恐怖" }, new Genre { Id = 10402, Name = "音乐" },
        new Genre { Id = 9648, Name = "悬疑" }, new Genre { Id = 10749, Name = "爱情" },
        new Genre { Id = 878, Name = "科幻" }, new Genre { Id = 53, Name = "惊悚" },
        new Genre { Id = 10752, Name = "战争" }, new Genre { Id = 37, Name = "西部" }
    };
}

<style>
    .browse-page {
        padding: 80px 5% 40px;
        min-height: 100vh;
    }

    .browse-header {
        margin-bottom: 2rem;
    }

    .browse-header h1 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
    }

    .filter-bar {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        padding: 1.5rem;
        background: var(--zhui-surface, #141414);
        border-radius: 12px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        min-width: 150px;
    }

    .filter-group label {
        font-size: 0.9rem;
        color: var(--zhui-muted, #94a3b8);
    }

    .filter-group select {
        padding: 0.5rem;
        background: var(--zhui-card, #1a1a2e);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 6px;
        color: var(--zhui-text, #f8fafc);
        cursor: pointer;
    }

    .filter-group select:focus {
        outline: none;
        border-color: var(--zhui-primary, #e50914);
    }

    .skeleton-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1.5rem;
    }

    .skeleton-card {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .skeleton-poster {
        aspect-ratio: 2/3;
        border-radius: 8px;
        background: var(--zhui-card, #1a1a2e);
    }

    .shimmer {
        animation: shimmer 1.5s infinite;
    }

    @@keyframes shimmer {
        0% { opacity: 0.5; }
        50% { opacity: 0.8; }
        100% { opacity: 0.5; }
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
    }

    .empty-state h2 {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }

    .empty-state p {
        color: var(--zhui-muted, #94a3b8);
        margin-bottom: 1.5rem;
    }

    .reset-btn {
        padding: 0.75rem 1.5rem;
        background: var(--zhui-primary, #e50914);
        border: none;
        border-radius: 6px;
        color: white;
        cursor: pointer;
        font-weight: 600;
    }

    .reset-btn:hover {
        opacity: 0.9;
    }

    .results-info {
        margin-bottom: 1.5rem;
        color: var(--zhui-muted, #94a3b8);
        font-size: 0.9rem;
    }

    .results-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1.5rem;
    }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        margin-top: 2rem;
        padding: 1rem;
    }

    .page-btn {
        padding: 0.6rem 1.5rem;
        background: var(--zhui-surface, #141414);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 6px;
        color: var(--zhui-text, #f8fafc);
        cursor: pointer;
        font-size: 0.9rem;
        transition: all 0.2s;
    }

    .page-btn:hover:not(:disabled) {
        background: var(--zhui-primary, #e50914);
        border-color: var(--zhui-primary, #e50914);
    }

    .page-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .page-info {
        color: var(--zhui-muted, #94a3b8);
        font-size: 0.9rem;
    }

    @@media (max-width: 768px) {
        .browse-page {
            padding: 80px 4% 40px;
        }

        .browse-header h1 {
            font-size: 1.5rem;
        }

        .filter-bar {
            flex-direction: column;
            gap: 1rem;
        }

        .filter-group {
            min-width: 100%;
        }
    }
</style>
