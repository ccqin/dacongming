@inject NavigationManager Navigation

<div class="movie-card" @onclick="HandleClick">
    <img class="poster" 
         src="@MovieService.GetPosterUrl(Movie.PosterPath, "w342")" 
         alt="@Movie.Title"
         loading="lazy" />
    
    <div class="card-overlay">
        <div class="card-title">@Movie.Title</div>
        <div class="card-rating">
            ⭐ @Movie.TmdbVoteAverage.ToString("F1")
        </div>
    </div>
</div>

@code {
    [Parameter] public Movie Movie { get; set; } = null!;
    [Parameter] public EventCallback OnClick { get; set; }
    
    [Inject] private MovieService MovieService { get; set; } = null!;

    private async Task HandleClick()
    {
        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }
}

<style>
    .movie-card {
        flex: 0 0 180px;
        scroll-snap-align: start;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
        border-radius: 8px;
        overflow: visible;
    }

    .movie-card:hover {
        transform: scale(1.08) translateY(-4px);
        z-index: 10;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.6), 0 0 0 2px rgba(229, 9, 20, 0.3);
    }

    .movie-card:hover .poster {
        border-radius: 8px 8px 0 0;
    }

    .movie-card:hover .card-overlay {
        opacity: 1;
    }

    .movie-card .poster {
        width: 100%;
        aspect-ratio: 2/3;
        object-fit: cover;
        border-radius: 8px;
        background: #1a1a2e;
        transition: border-radius 0.3s ease;
    }

    .card-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 0.75rem;
        background: linear-gradient(transparent, rgba(0,0,0,0.95));
        border-radius: 0 0 8px 8px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .card-overlay .card-title {
        font-size: 0.85rem;
        font-weight: 500;
        margin: 0;
        white-space: normal;
        overflow: visible;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .card-overlay .card-rating {
        font-size: 0.75rem;
        color: #fbbf24;
        margin-top: 0.25rem;
    }
</style>
